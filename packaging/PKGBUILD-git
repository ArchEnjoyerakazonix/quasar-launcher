# Maintainer: ArchEnjoyerakazonix <archenjoyerakazonix@users.noreply.github.com>
pkgname=quasar-launcher-git
pkgver=1.0.0.r0.g7443feb
pkgrel=1
pkgdesc="Next-generation application launcher & command palette for Wayland and X11 (Qt6/QML) (VCS version)"
arch=('x86_64' 'aarch64')
url="https://github.com/ArchEnjoyerakazonix/quasar-launcher"
license=('MIT')
provides=('quasar-launcher')
conflicts=('quasar-launcher')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-svg'
    'hicolor-icon-theme'
)
makedepends=(
    'git'
    'cmake'
    'ninja'
    'qt6-tools'
    'layer-shell-qt'
)
optdepends=(
    'hyprland: window switching on Hyprland (w. / w: prefix)'
    'sway: window switching on Sway (w. / w: prefix)'
    'wmctrl: window switching on X11 (w. / w: prefix)'
    'cliphist: clipboard history manager (c. / clip. prefix)'
    'wl-clipboard: clipboard utilities for Wayland'
    'python-pywal: dynamic wallpaper color scheme sync'
    'xdg-terminal-exec: running shell commands ($) in the standard terminal'
)
source=("git+https://github.com/ArchEnjoyerakazonix/quasar-launcher.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/quasar"
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "1.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cmake -B build -S "${srcdir}/quasar" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "${srcdir}/quasar/assets/actions.json.example" \
        "$pkgdir/usr/share/doc/quasar/actions.json.example"
    install -Dm644 "${srcdir}/quasar/LICENSE" \
        "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
